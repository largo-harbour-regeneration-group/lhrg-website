---
import PhotoTile from './PhotoTile.astro';
import PlaceholderImage from './PlaceholderImage.astro';
import type { Person } from '../content/data/people';

type Props = Person;

const { name, role, bio, photo } = Astro.props;
---

<article class="person-card">
	{
		photo ? (
			<PhotoTile
				src={photo}
				alt={`Photo of ${name}`}
				aspectRatio="1 / 1"
				objectPosition="50% 20%"
				width={320}
			/>
		) : (
			<PlaceholderImage label={`Photo: ${name}`} aspectRatio="1 / 1" />
		)
	}
	<h3 class="person-card__name">{name}</h3>
	<p class="person-card__role">{role}</p>
	<p class="person-card__bio">{bio}</p>
</article>

<style>
	.person-card {
		background: var(--color-white);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		padding: var(--space-3);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.person-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(5, 68, 122, 0.18);
	}

	.person-card__name {
		margin: var(--space-3) 0 0;
		font-size: var(--text-lg);
	}

	.person-card__role {
		margin: 0 0 var(--space-2);
		color: var(--color-teal);
		font-weight: 600;
		font-size: var(--text-sm);
	}

	.person-card__bio {
		margin: 0;
		font-size: var(--text-sm);
	}
</style>
