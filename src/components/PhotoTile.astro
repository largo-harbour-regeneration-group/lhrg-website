---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	aspectRatio?: string;
	objectPosition?: string;
	width?: number;
	credit?: string;
	creditUrl?: string;
}

const {
	src,
	alt,
	aspectRatio = '4 / 3',
	objectPosition = '50% 50%',
	width = 480,
	credit,
	creditUrl,
} = Astro.props;
---

<figure class="photo-tile" style={`aspect-ratio: ${aspectRatio};`}>
	<Image src={src} alt={alt} width={width} densities={[1, 2]} format="webp" style={`object-position: ${objectPosition};`} />
	{
		credit && (
			<figcaption class="photo-tile__credit">
				Photo:{' '}
				{creditUrl ? (
					<a href={creditUrl} target="_blank" rel="noopener noreferrer">
						{credit}
					</a>
				) : (
					credit
				)}
			</figcaption>
		)
	}
</figure>

<style>
	.photo-tile {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		transition: box-shadow 0.2s ease;
	}

	.photo-tile:hover {
		box-shadow: 0 12px 28px rgba(5, 68, 122, 0.25);
	}

	.photo-tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.photo-tile:hover :global(img) {
		transform: scale(1.06);
	}

	.photo-tile__credit {
		position: absolute;
		right: 0;
		bottom: 0;
		background: rgba(5, 68, 122, 0.75);
		color: var(--color-white);
		font-size: 0.7rem;
		padding: 2px 6px;
		border-top-left-radius: var(--radius);
	}

	.photo-tile__credit a {
		color: inherit;
	}
</style>
